<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule as backup_rules.xml: the pairing state stays with
     this install, for cloud backups and device-to-device transfers alike. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="supabase_session.xml" />
        <exclude domain="sharedpref" path="couple.xml" />
        <exclude domain="sharedpref" path="sync_cursor.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="supabase_session.xml" />
        <exclude domain="sharedpref" path="couple.xml" />
        <exclude domain="sharedpref" path="sync_cursor.xml" />
    </device-transfer>
</data-extraction-rules>
